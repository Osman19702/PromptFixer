# ---- PromptFixer configuration -------------------------------------------
# Copy this file to `.env` and fill in the provider(s) you actually use.
# Every provider is optional; the app only offers the ones with a key present.
# Ollama needs no key at all. Restart the app after editing.
#
# Where `.env` lives:
#   installed desktop app  → Electron's user-data directory, e.g.
#                            %APPDATA%\PromptFixer\.env (Windows),
#                            ~/Library/Application Support/PromptFixer/.env (macOS),
#                            ~/.config/PromptFixer/.env (Linux)
#   npm run desktop / dev / start / setup → this project directory

# Port the backend listens on (frontend dev server proxies /api here)
PORT=8787

# --- Local model (built-in, no key) ---------------------------------------
# Which tier to use: lite (1 GB) | default (2.5 GB, recommended) | quality (4.7 GB)
# Unset = picked automatically from this machine's RAM.
# PROMPTFIXER_MODEL=default

# Where model files live (default: ~/.promptfixer/models)
# PROMPTFIXER_MODEL_DIR=

# Where the prompt library is stored (default: Electron's user-data directory in
# the desktop app, server/data/ in browser mode)
# PROMPTFIXER_DATA_DIR=

# Load the model at startup instead of on the first fix (the desktop app sets this)
# PROMPTFIXER_PRELOAD=1

# Release the model after this long with nothing to do, so the app stops holding
# 2.5 GB it is not using. The next fix loads it again. 0 keeps it loaded for ever.
# PROMPTFIXER_IDLE_UNLOAD_MS=900000

# Stop one local fix after this long. Generous on purpose: a fix takes 15-35 s on
# a GPU and 30-90 s without one, so this only ends a run that was never going to
# finish. 0 removes the limit.
# PROMPTFIXER_FIX_TIMEOUT_MS=300000

# Which provider the UI selects on first load:
# local | anthropic | openai | openrouter | google | ollama | compatible
DEFAULT_PROVIDER=local

# Optional: force a specific model instead of the provider default
# DEFAULT_MODEL=claude-sonnet-5

# --- Anthropic (Claude) ---------------------------------------------------
ANTHROPIC_API_KEY=

# --- OpenAI ---------------------------------------------------------------
OPENAI_API_KEY=

# --- OpenRouter (one key, many models) ------------------------------------
OPENROUTER_API_KEY=

# --- Google Gemini --------------------------------------------------------
GOOGLE_API_KEY=

# --- Ollama (local, no key needed) ----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434

# --- Any other OpenAI-compatible endpoint (LM Studio, vLLM, Groq, Together)
# COMPATIBLE_BASE_URL=http://localhost:1234/v1
# COMPATIBLE_API_KEY=
# COMPATIBLE_LABEL=LM Studio
